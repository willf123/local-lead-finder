# ─── Trigger.dev ────────────────────────────────────────────────────────────
# Secret key for the DEV environment: cloud.trigger.dev → your project → API Keys → "dev" secret key (starts with tr_dev_)
TRIGGER_SECRET_KEY=

# ─── Dental leads automation (src/trigger/dental-leads) ─────────────────────
# Google Cloud API key with BOTH "Places API (New)" and "PageSpeed Insights API" enabled.
# console.cloud.google.com → APIs & Services → Credentials → Create credentials → API key
GOOGLE_PLACES_API_KEY=

# ClickUp personal API token (starts with pk_): ClickUp → avatar → Settings → Apps → API Token → Generate
CLICKUP_API_TOKEN=

# ID of the ClickUp list where lead tasks go. Open the list in your browser —
# the URL looks like app.clickup.com/1234567/v/li/901234567890 → the number after /li/ is the list ID.
CLICKUP_LIST_ID=
